{
  "name": "halo",
  "version": "0.1.1",
  "main": "boot.js",
  "repository": {
  "type": "git",
  "url": "https://github.com/Mirage00k/Halo-Releases.git"
  },
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never",
    "release": "electron-builder --win portable --publish always",
    "patch": "node make-patch.js"
  },
  "dependencies": {
    "lucide-static": "^0.460.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.halo.app",
    "productName": "Halo",
    "artifactName": "Halo-${version}.exe",
    "files": [
      "boot.js",
      "main.js",
      "preload.js",
      "renderer.js",
      "style.css",
      "index.html",
      "*.ps1",
      "icon/**",
      "package.json"
    ],
    "asarUnpack": [
      "*.ps1"
    ],
    "win": {
      "target": "portable",
      "icon": "icon/icon.ico"
    }
  }
}